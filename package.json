    "@opencode/plugin": "2.3.0",
    "@types/node": "^26.6.2",
    "effect": "4.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^5.0.1"
